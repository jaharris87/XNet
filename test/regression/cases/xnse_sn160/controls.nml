! Maintained standalone input for the standalone NSE-process check.
&xnet_config
  description(1) = 'NSE process verification',
  description(2) = 'SN160 software behavior',
  description(3) = 'characterization only',

  ! Job, batching, and integration Controls
  szone = 1,
  nzone = 1,
  iweak0 = 1,
  iscrn = 1,
  iprocess = 1,
  nzbatchmx = 1,
  isolv = 1,
  kstmx = 6000,
  kitmx = 5,
  ijac = 4,
  iconvc = 0,
  changemx = 1.00e-01,
  yacc = 1.00e-07,
  tolm = 1.00e-06,
  tolc = 1.00e-04,
  ymin = 1.00e-30,
  tdel_maxmult = 2.00e+00,

  ! Self-heating, NSE, and Neutrino Controls
  iheat = 0,
  changemxt = 1.00e-02,
  tolt9 = 1.00e-04,
  t9nse = 8.0,
  ineutrino = 0,

  ! Output Controls
  idiag = 1,
  itsout = 0,
  ev_file_base = 'ev_xnse_sn160_',
  bin_file_base = 'ts_xnse_sn160_',
  nnucout = 14,
  output_nuclei(1) = 'p',
  output_nuclei(2) = 'he4',
  output_nuclei(3) = 'c12',
  output_nuclei(4) = 'o16',
  output_nuclei(5) = 'ne20',
  output_nuclei(6) = 'mg24',
  output_nuclei(7) = 'si28',
  output_nuclei(8) = 'ca40',
  output_nuclei(9) = 'ti44',
  output_nuclei(10) = 'cr48',
  output_nuclei(11) = 'fe52',
  output_nuclei(12) = 'fe54',
  output_nuclei(13) = 'ni56',
  output_nuclei(14) = 'zn60',

  ! Standalone Input Controls
  data_dir = 'Data_SN160',
  inab_files(1) = 'Data_SN160/ab_ye49',
  thermo_files(1) = 'unused',
/
