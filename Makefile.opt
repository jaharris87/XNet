# User-selectable defaults. Override these on the Make command line rather
# than editing this file for a local build. Unless BUILD_NAME or BUILD_DIR is
# supplied, the major choices below form a readable build-directory name.

# OPT or DEBUG.
CMODE ?= OPT
# GNU, INTEL, PGI, NVIDIA, NVHPC, LLVM, CCE, CRAY, or XL.
PE_ENV ?= GNU

# MPI and host OpenMP: ON or OFF.
MPI_MODE ?= OFF
OPENMP_MODE ?= OFF

# Accelerator libraries and directives: ON or OFF. GPU builds use CUDA with
# CUBLAS or MAGMA, or HIP with ROCM, and exactly one directive model.
GPU_MODE ?= OFF
GPU_BACKEND ?= CUDA
GPU_LAPACK_VER ?= CUBLAS
OPENACC_MODE ?= OFF
OPENMP_OL_MODE ?= OFF

# STARKILLER, BAHCALL, HELMHOLTZ, or EXTERNAL (libxnet only).
EOS ?= STARKILLER
# EXTERNAL uses a supplied free-form module xnet_thermo for thermodynamics;
# XNet keeps composition moments, screening, scratch, and unit conversions.
# The host builds its EOS modules first and owns their initialization,
# cleanup, and link dependencies.
# EOS_SOURCE = /path/to/xnet_thermo.F90
# EOS_MODULE_DIR = /path/to/host/modules
# dense, MA41, MA48, or the oneMKL implementation PARDISO_MKL.
MATRIX_SOLVER ?= dense

# LAPACK_VER defaults to NETLIB on generic hosts and LIBSCI on the maintained
# HPE Cray Programming Environment hosts. It may be set explicitly to NETLIB,
# MKL, LIBSCI, ATLAS, ACCEL, PGIBLAS, or ESSL.
