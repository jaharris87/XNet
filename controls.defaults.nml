! XNet standalone-control template.
!
! The compiled defaults in source/xnet_controls.F90 are authoritative.  This
! maintained template records those defaults for users and review.  A problem
! must supply data_dir, inab_files, and thermo_files before this is a complete
! standalone input.  Uncomment include to layer other files after this one;
! later files and later include entries take precedence.
&xnet_config
  ! Problem Description
  description(1) = '',
  description(2) = '',
  description(3) = '',

  ! Job Controls
  szone          = 1,
  nzone          = 1,
  iweak0         = 1,
  iscrn          = 1,
  iprocess       = 0,

  ! Zone Batching Controls
  nzbatchmx      = 1,

  ! Integration Controls
  isolv          = 1,
  kstmx          = 9999,
  kitmx          = 5,
  ijac           = 1,
  iconvc         = 0,
  changemx       = 1.0e-1,
  yacc           = 1.0e-7,
  tolm           = 1.0e-6,
  tolc           = 1.0e-4,
  ymin           = 1.0e-30,
  tdel_maxmult   = 2.0,

  ! Self-heating Controls
  iheat          = 0,
  changemxt      = 1.0e-2,
  tolt9          = 1.0e-4,

  ! NSE Initial Conditions Controls
  t9nse          = 8.0,

  ! Neutrino Controls
  ineutrino      = 0,

  ! Output Controls
  idiag          = 0,
  itsout         = 0,
  ev_file_base   = 'ev_',
  bin_file_base  = 'ts_',
  nnucout        = 0,
  ! output_nuclei(1) = 'he4',

  ! Standalone Input Controls -- supply values for the problem being run.
  data_dir       = '',
  ! inab_files(1)  = 'path/to/initial_abundances',
  ! thermo_files(1)= 'path/to/thermodynamic_history',

  ! Ordered layered input -- each path is relative to the file naming it.
  ! include(1) = 'problem-controls.nml',
/
