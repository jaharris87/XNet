! Maintained standalone input for the batch_alpha regression case.
&xnet_config
  ! Problem Description
  description(1) = '2000 timesteps',
  description(2) = 'diagnostic level 1',
  description(3) = 'New parameters',

  ! Job and Zone Batching Controls
  szone          = 1,
  nzone          = 16,
  iweak0         = 1,
  iscrn          = 1,
  iprocess       = 1,
  nzbatchmx      = 4,

  ! Integration Controls
  isolv          = 1,
  kstmx          = 9999,
  kitmx          = 5,
  ijac           = 1,
  iconvc         = 0,
  changemx       = 1.00e-01,
  yacc           = 1.00e-07,
  tolm           = 1.00e-06,
  tolc           = 1.00e-04,
  ymin           = 1.00e-30,
  tdel_maxmult   = 2.00e+00,

  ! Self-heating, NSE, and Neutrino Controls
  iheat          = 1,
  changemxt      = 1.00e-02,
  tolt9          = 1.00e-04,
  t9nse          = 11.0,
  ineutrino      = 0,

  ! Output Controls
  idiag          = 0,
  itsout         = 2,
  ev_file_base   = 'ev_batch_alpha_',
  bin_file_base  = 'ts_batch_alpha_',
  nnucout        = 14,
  output_nuclei(1)  = 'he4',
  output_nuclei(2)  = 'c12',
  output_nuclei(3)  = 'o16',
  output_nuclei(4)  = 'ne20',
  output_nuclei(5)  = 'mg24',
  output_nuclei(6)  = 'si28',
  output_nuclei(7)  = 's32',
  output_nuclei(8)  = 'ar36',
  output_nuclei(9)  = 'ca40',
  output_nuclei(10) = 'ti44',
  output_nuclei(11) = 'cr48',
  output_nuclei(12) = 'fe52',
  output_nuclei(13) = 'ni56',
  output_nuclei(14) = 'zn60',

  ! Standalone Input Controls. The single filename pair expands over all zones.
  data_dir       = 'Data_alpha',
  inab_files(1)  = 'Data_alpha/ab_batch/ab_batch_',
  thermo_files(1)= 'Test_Problems/th_batch/th_batch_',
/
